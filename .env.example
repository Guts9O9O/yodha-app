# Copy to .env.local for local development and fill in the blanks. Never commit real values.
# Production values live in the Vercel project settings (docs/ARCHITECTURE.md §8.2).

# --- Database -------------------------------------------------------------
# Local values match docker-compose.yml (start it with: npm run db:up).
# Runtime connection. Production: the Neon *pooled* string (host contains "-pooler").
DATABASE_URL=postgresql://yoddha:yoddha@localhost:5433/yoddha_dev
# Migrations and backups. Production: the Neon *direct* string (no "-pooler").
DATABASE_URL_DIRECT=postgresql://yoddha:yoddha@localhost:5433/yoddha_dev
# Integration tests. This database is wiped by the tests; never point it at real data.
TEST_DATABASE_URL=postgresql://yoddha:yoddha@localhost:5433/yoddha_test

# --- Auth (Better Auth; used from M2) ---------------------------------------
# Random secret, at least 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Base URL of the app (production: the Vercel URL).
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth client (Google Cloud Console). Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google account emails allowed to sign in. Everyone else is refused.
ALLOWED_EMAILS=
