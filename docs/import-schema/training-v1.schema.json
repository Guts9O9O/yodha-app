{
  "title": "Yoddha Prep training plan (schemaVersion 1)",
  "description": "Structure only. Rules that compare fields (dates inside the plan, athletes and foods referenced consistently, gramsPerUnit by unit, unique keys) and checks that need the app's data (diet rules, station keys, costs) are applied by the app's import preview. Full spec: docs/IMPORT_FORMAT.md.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "planKey": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,62}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "versionNote": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "draft",
            "approved"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "endDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "assumptions": {
      "anyOf": [
        {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "type": "string",
      "const": "training"
    },
    "athletes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,30}$"
      }
    },
    "eventCategory": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,62}\\/[a-z][a-z0-9_]{1,62}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sessions": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "athletes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,30}$"
            }
          },
          "joint": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "run",
              "strength",
              "station",
              "combo",
              "mobility",
              "rest",
              "test"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "objective": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "estimatedMinutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 600
              },
              {
                "type": "null"
              }
            ]
          },
          "warmup": {
            "anyOf": [
              {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "blocks": {
            "anyOf": [
              {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "exercises": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          },
                          "category": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_]{1,62}$"
                          },
                          "stationKey": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9_]{1,62}$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "sets": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 100
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "reps": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 1000
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "distanceM": {
                            "anyOf": [
                              {
                                "type": "number",
                                "exclusiveMinimum": 0,
                                "maximum": 50000
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "durationSec": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 36000
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "load": {
                            "anyOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "kg": {
                                    "anyOf": [
                                      {
                                        "type": "number",
                                        "exclusiveMinimum": 0,
                                        "maximum": 500
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "guidance": {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "maxLength": 120
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  }
                                },
                                "additionalProperties": false
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "restSec": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 3600
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "targetRpe": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^\\d{1,2}(-\\d{1,2})?$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "notes": {
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 2000
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "perAthlete": {
                            "anyOf": [
                              {
                                "type": "object",
                                "propertyNames": {
                                  "type": "string",
                                  "pattern": "^[a-z][a-z0-9_]{1,30}$"
                                },
                                "additionalProperties": {
                                  "type": "object",
                                  "properties": {
                                    "sets": {
                                      "anyOf": [
                                        {
                                          "type": "integer",
                                          "minimum": 1,
                                          "maximum": 100
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "reps": {
                                      "anyOf": [
                                        {
                                          "type": "integer",
                                          "minimum": 1,
                                          "maximum": 1000
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "distanceM": {
                                      "anyOf": [
                                        {
                                          "type": "number",
                                          "exclusiveMinimum": 0,
                                          "maximum": 50000
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "durationSec": {
                                      "anyOf": [
                                        {
                                          "type": "integer",
                                          "minimum": 1,
                                          "maximum": 36000
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "load": {
                                      "anyOf": [
                                        {
                                          "type": "object",
                                          "properties": {
                                            "kg": {
                                              "anyOf": [
                                                {
                                                  "type": "number",
                                                  "exclusiveMinimum": 0,
                                                  "maximum": 500
                                                },
                                                {
                                                  "type": "null"
                                                }
                                              ]
                                            },
                                            "guidance": {
                                              "anyOf": [
                                                {
                                                  "type": "string",
                                                  "maxLength": 120
                                                },
                                                {
                                                  "type": "null"
                                                }
                                              ]
                                            }
                                          },
                                          "additionalProperties": false
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "restSec": {
                                      "anyOf": [
                                        {
                                          "type": "integer",
                                          "minimum": 0,
                                          "maximum": 3600
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "targetRpe": {
                                      "anyOf": [
                                        {
                                          "type": "string",
                                          "pattern": "^\\d{1,2}(-\\d{1,2})?$"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "notes": {
                                      "anyOf": [
                                        {
                                          "type": "string",
                                          "maxLength": 2000
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    }
                                  },
                                  "additionalProperties": false
                                }
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "name",
                          "category"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "name",
                    "exercises"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "cooldown": {
            "anyOf": [
              {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "recovery": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "stopCriteria": {
            "anyOf": [
              {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "lighterOption": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "date",
          "athletes",
          "type",
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "startDate",
    "endDate",
    "kind",
    "athletes",
    "sessions"
  ],
  "additionalProperties": false
}
