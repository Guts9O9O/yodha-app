{
  "title": "Yoddha Prep nutrition plan (schemaVersion 1)",
  "description": "Structure only. Rules that compare fields (dates inside the plan, athletes and foods referenced consistently, gramsPerUnit by unit, unique keys) and checks that need the app's data (diet rules, station keys, costs) are applied by the app's import preview. Full spec: docs/IMPORT_FORMAT.md.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "planKey": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,62}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "versionNote": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "draft",
            "approved"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "endDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "assumptions": {
      "anyOf": [
        {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "type": "string",
      "const": "nutrition"
    },
    "athlete": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,30}$"
    },
    "budgetInrPerDay": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "targets": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kcal": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "proteinG": {
              "anyOf": [
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                {
                  "type": "null"
                }
              ]
            },
            "carbsG": {
              "anyOf": [
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                {
                  "type": "null"
                }
              ]
            },
            "fatG": {
              "anyOf": [
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                {
                  "type": "null"
                }
              ]
            },
            "fibreG": {
              "anyOf": [
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                {
                  "type": "null"
                }
              ]
            },
            "fluidNote": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            },
            "rationale": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 2000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kcal"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "foods": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,62}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "dietTag": {
            "type": "string",
            "enum": [
              "veg",
              "egg",
              "chicken",
              "fish",
              "other_meat"
            ]
          },
          "per100g": {
            "type": "object",
            "properties": {
              "kcal": {
                "type": "number",
                "minimum": 0
              },
              "proteinG": {
                "type": "number",
                "minimum": 0
              },
              "carbsG": {
                "type": "number",
                "minimum": 0
              },
              "fatG": {
                "type": "number",
                "minimum": 0
              },
              "fibreG": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "kcal",
              "proteinG",
              "carbsG",
              "fatG"
            ],
            "additionalProperties": false
          },
          "householdMeasures": {
            "anyOf": [
              {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "grams": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "label",
                    "grams"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "isEstimate": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "name",
          "dietTag",
          "per100g",
          "source",
          "isEstimate"
        ],
        "additionalProperties": false
      }
    },
    "prices": {
      "anyOf": [
        {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "foodKey": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,62}$"
              },
              "priceInr": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "perQty": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": "string",
                "enum": [
                  "g",
                  "kg",
                  "ml",
                  "l",
                  "piece"
                ]
              },
              "gramsPerUnit": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "asOf": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "isEstimate": {
                "type": "boolean"
              },
              "excludeFromBudget": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "foodKey",
              "priceInr",
              "perQty",
              "unit",
              "asOf",
              "source",
              "isEstimate"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "days": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "meals": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "breakfast",
                    "lunch",
                    "pre_workout",
                    "post_workout",
                    "dinner",
                    "snack"
                  ]
                },
                "time": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "items": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "foodKey": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{1,62}$"
                      },
                      "grams": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 5000
                      },
                      "household": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 120
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "foodKey",
                      "grams"
                    ],
                    "additionalProperties": false
                  }
                },
                "prep": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 2000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "substitutions": {
                  "anyOf": [
                    {
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "type",
                "name",
                "items"
              ],
              "additionalProperties": false
            }
          },
          "expectedTotals": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kcal": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "proteinG": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "carbsG": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "fatG": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "fibreG": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "costInr": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "date",
          "meals"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "startDate",
    "endDate",
    "kind",
    "athlete",
    "foods",
    "days"
  ],
  "additionalProperties": false
}
